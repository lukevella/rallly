model InstanceSettings {
  id                      Int     @id @default(1)
  // Authentication & Security
  disableUserRegistration Boolean @default(false) @map("disable_user_registration")

  // Anonymous identifier used when the instance checks for updates
  instanceId String @unique @default(dbgenerated("gen_random_uuid()")) @map("instance_id") @db.Uuid

  // Branding (unset values fall through to env vars, then defaults)
  appName          String?  @map("app_name")
  primaryColor     String?  @map("primary_color")
  primaryColorDark String?  @map("primary_color_dark")
  // Logo values are storage keys or absolute URLs
  logo             String?
  logoDark         String?  @map("logo_dark")
  logoIcon         String?  @map("logo_icon")
  hideAttribution  Boolean? @map("hide_attribution")

  // Ordered [{ label, href }] rendered in the login and invite page footers.
  // Not branding: this is how self-hosted instances satisfy local legal
  // disclosure requirements (Impressum, privacy policy), so it is not gated.
  footerLinks      Json     @default("[]") @map("footer_links")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("instance_settings")
}
