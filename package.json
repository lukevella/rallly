{
  "name": "rallly",
  "private": true,
  "version": "4.16.1",
  "scripts": {
    "dev": "turbo dev --filter=@rallly/web",
    "dev:emails": "turbo dev --filter=@rallly/emails",
    "dev:landing": "turbo dev --filter=@rallly/landing",
    "start": "turbo run start --filter=@rallly/web",
    "build": "dotenv -c -- turbo run build --filter=@rallly/web",
    "build:web": "NEXT_PUBLIC_APP_VERSION=$(node scripts/inject-version.js) turbo run build --filter=@rallly/web",
    "build:landing": "turbo run build --filter=@rallly/landing",
    "build:test": "turbo build:test",
    "docs:dev": "turbo dev --filter=@rallly/docs...",
    "db:deploy": "pnpm --filter @rallly/database exec prisma migrate deploy",
    "db:generate": "pnpm --filter @rallly/database exec prisma generate",
    "db:migrate": "pnpm --filter @rallly/database exec prisma migrate dev",
    "db:reset": "pnpm --filter @rallly/database exec prisma migrate reset && pnpm db:seed",
    "db:seed": "pnpm --filter @rallly/database exec prisma db seed",
    "db:push": "pnpm --filter @rallly/database exec prisma db push",
    "db:format": "pnpm --filter @rallly/database exec prisma format",
    "proxy:start": "portless proxy start",
    "proxy:stop": "portless proxy stop",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "docker:pull": "docker compose -f docker-compose.dev.yml pull",
    "docker:down": "docker compose -f docker-compose.dev.yml down --volumes --remove-orphans",
    "test:integration": "turbo test:integration",
    "test:unit": "turbo test:unit",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "lint": "oxlint",
    "check:locales": "node scripts/check-locale-braces.mjs",
    "check:structure": "node scripts/check-feature-structure.mjs && node scripts/check-feature-cycles.mjs",
    "check:cascades": "node scripts/check-user-cascade-relations.mjs",
    "check:openapi": "pnpm --filter @rallly/web openapi:generate && git diff --exit-code -- apps/docs/api-reference/openapi.json",
    "i18n:scan": "turbo i18n:scan",
    "type-check": "turbo type-check",
    "release": "./scripts/create-release.sh",
    "screenshots": "pnpm --filter @rallly/screenshots capture",
    "sherif": "pnpx sherif@latest",
    "sherif:fix": "pnpx sherif@latest --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "^0.1.0",
    "dotenv-cli": "^8.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.83.0",
    "portless": "^0.15.6",
    "prettier": "^3.5.3",
    "prisma": "^7.8.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
