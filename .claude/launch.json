{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DEV_DOMAIN=ral1477.rallly.test",
        "pnpm",
        "--filter",
        "@rallly/web",
        "dev"
      ],
      "url": "https://ral1477.rallly.test",
      "autoPort": true
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@rallly/docs", "dev", "--port", "3333"],
      "port": 3333
    }
  ]
}
