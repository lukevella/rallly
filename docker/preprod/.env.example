DOMAIN=example.org
AUTHELIA_TAG=4.39
HOST_UID=1000
HOST_GID=1000

# openssl rand -hex 32 pour chacun
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=
AUTHELIA_OIDC_HMAC_SECRET=
RALLLY_SECRET_PASSWORD=
GARAGE_RPC_SECRET=

# Secret OIDC de Rallly (clair) et son empreinte pbkdf2 pour Authelia.
# Apostrophes obligatoires : sans elles, Compose interprète les « $ » de l'empreinte.
#   authelia crypto hash generate pbkdf2 --variant sha512 --password "$RALLLY_OIDC_CLIENT_SECRET"
RALLLY_OIDC_CLIENT_SECRET=
RALLLY_OIDC_CLIENT_SECRET_DIGEST=''

# Profil « tunnel » : docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
