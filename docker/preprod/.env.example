# Tout est optionnel : sans .env, `docker compose up -d` génère les secrets (init.sh) et sert la stack
# sur https://rallly.m2.localhost (les adresses en .localhost pointent vers la machine).

# DOMAIN=m2.localhost
# AUTHELIA_TAG=4.39
# HOST_UID=1000
# HOST_GID=1000

# Reprise d'un déploiement existant : une valeur posée ici est utilisée telle quelle au lieu d'être générée
# (changer la clé de chiffrement d'Authelia ou le mot de passe d'une base existante les rendrait inutilisables).
# Une base existante, sans valeur ici, garde son mot de passe d'origine (init la reconnaît).
# Lue au premier démarrage seulement : docker compose down -v repart de zéro.
# AUTHELIA_SESSION_SECRET=
# AUTHELIA_STORAGE_ENCRYPTION_KEY=
# AUTHELIA_JWT_SECRET=
# AUTHELIA_OIDC_HMAC_SECRET=
# AUTHELIA_DB_PASSWORD=
# RALLLY_DB_PASSWORD=
# RALLLY_SECRET_PASSWORD=
# RALLLY_OIDC_CLIENT_SECRET=
# GARAGE_RPC_SECRET=
# ADMIN_PASSWORD=   (mot de passe du compte admin créé par init ; sans effet si users_database.yml existe)

# Profil « tunnel » : docker compose --profile tunnel up -d
# CLOUDFLARE_TUNNEL_TOKEN=
