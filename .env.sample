# Variables for the Docker Compose files in this repository.
# Copy this file to .env and fill in the values. Never commit .env.
# Replace every value below before any public deployment.
#
# Some values are fixed when a volume is first created (database user,
# password and name, Garage keys). Changing them later needs a fresh volume.

# --- Database (PostgreSQL) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Port opened on this computer for tools such as DataGrip.
POSTGRES_PORT=

# --- App ---
# Port where the app is served on this computer.
APP_PORT=

# --- Redis REST proxy ---
# The app receives this same value as KV_REST_API_TOKEN.
SRH_TOKEN=

# --- Garage (S3 compatible storage) ---
# GARAGE_RPC_SECRET must be 64 hex characters: openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
