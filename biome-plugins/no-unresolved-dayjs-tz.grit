// dayjs converts with the engine's own tz data, which lags recent rule
// changes (Alberta, Manitoba, British Columbia in 2026). Route the zone
// through `@/lib/datetime/time-zone-overrides` so server and browser agree.
language js

or {
  `$obj.tz($zone, $keepLocalTime)` as $match,
  `$obj.tz($zone)` as $match
} where {
  $zone <: not or {
    `resolveTimeZone($zoneId, $instant)`,
    `resolveTimeZoneAtWallTime($zoneId, $wallTime)`
  },
  $filename <: not or {
    r".*\.test\.tsx?",
    r".*/tests/.*",
    r".*/scripts/.*",
    r".*/packages/.*",
    r".*/apps/landing/.*"
  },
  register_diagnostic(span=$match, message="Pass the zone through `resolveTimeZone` or `resolveTimeZoneAtWallTime` from `@/lib/datetime/time-zone-overrides` so recent rule changes apply on every engine.")
}
